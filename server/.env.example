# Scribble Server Configuration
FLASK_ENV=development     # Override the default (production) for local dev
FLASK_PORT=5000
FLASK_DEBUG=1             # 1=debug on, 0=debug off
CORS_ORIGINS=http://localhost:5173   # comma-separated list

# Security
SECRET_KEY=change-me-in-production   # Flask session signing key
DATABASE_URL=sqlite:///instance/scribble.db  # SQLAlchemy database URI

# SMTP Configuration (for sending verification/password-reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true
